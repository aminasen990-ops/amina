                { level: '🗣️ Быт', items: '他巴不得你走 (Он только и ждёт, чтобы ты ушёл)', example: '听说明天放假，同学们巴不得立刻飞回家。' },
                { level: '🎥 Медиа/СМИ', items: '消费心态：巴不得“一分钱当两分花” (Психология потребителя: сгорают от желания сэкономить)',
                    example: '在快节奏的时代，受众巴不得在十秒钟内获取所有关键信息。' }
            ],
            polyglotText: '最近手头资金比较紧巴，为了拿到这个项目，他甚至去巴结负责人。他心中一直在盼望着好消息，巴不得明天就能收到预付款。',
            polyglotTranslation: 'В последнее время с деньгами у него было впритык, поэтому, чтобы получить этот проект, он даже стал заискивать перед руководителем. В душе он страстно надеялся на хорошие новости и сгорал от желания, чтобы предоплату перевели уже завтра.'
        }];

        // ===================== СОСТОЯНИЕ =====================
        let cards = [];
        const STORAGE_KEY = 'hsk6_lesson1_v4';
        let currentCategory = 'all';
        let partFilter = 'all';
        let sortOrder = 'newest';
        let searchQuery = '';
        let pinyinVisible = true;
        let transVisible = true;
        let currentModalId = null;
        let isEditing = false;
        let editingCard = null;
        let activeTab = 'skeleton';
        let ankiIndex = 0;
        let ankiFlipped = false;
        let ankiTimer = null;

        // ===================== ЗАГРУЗКА =====================
        function loadCards() {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
                try {
                    cards = JSON.parse(saved);
                    if (!Array.isArray(cards) || cards.length === 0) cards = [...defaultCards];
                } catch (e) {
                    cards = [...defaultCards];
                }
            } else {
                cards = [...defaultCards];
            }
        }

        function saveCards() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(cards));
        }

        function resetCards() {
            if (confirm('Сбросить все пользовательские карточки и изменения?')) {
                cards = [...defaultCards];
                saveCards();
                renderAll();
                closeAllModals();
            }
        }

        // ===================== ФИЛЬТРЫ =====================
        function getFilteredCards() {
            let result = cards.filter(card => {
                if (currentCategory !== 'all' && card.category !== currentCategory) return false;
                if (partFilter !== 'all') {
                    const typeLower = (card.type || '').toLowerCase();
                    if (!typeLower.includes(partFilter.toLowerCase())) return false;
                }
                if (searchQuery.trim()) {
                    const q = searchQuery.trim().toLowerCase();
                    const searchable = [
                        card.word, card.pinyin, card.translation,
                        card.type || '', card.frame || '', card.anchor || '',
                        card.mnemonics ? card.mnemonics.join(' ') : '',
                        card.cognates ? card.cognates.join(' ') : '',
                        card.expertise || '', card.socialVibe || '',
                        card.expertInsight || '', card.reduction || '',
                        card.dialogue ? card.dialogue.join(' ') : '',
                        card.collocations ? card.collocations.map(c => c.items + ' ' + c.example).join(' ') : '',
                        card.polyglotText || '', card.polyglotTranslation || ''
                    ].join(' ').toLowerCase();
                    if (!searchable.includes(q)) return false;
                }
                return true;
            });

            if (sortOrder === 'newest') {
                result.sort((a, b) => {
                    const aTime = a.id.includes('card_') ? parseInt(a.id.split('_')[1]) || 0 : 0;
                    const bTime = b.id.includes('card_') ? parseInt(b.id.split('_')[1]) || 0 : 0;
                    return bTime - aTime;
                });
            } else if (sortOrder === 'oldest') {
                result.sort((a, b) => {
                    const aTime = a.id.includes('card_') ? parseInt(a.id.split('_')[1]) || 0 : 0;
                    const bTime = b.id.includes('card_') ? parseInt(b.id.split('_')[1]) || 0 : 0;
                    return aTime - bTime;
                });
            } else if (sortOrder === 'alphabet') {
                result.sort((a, b) => a.pinyin.localeCompare(b.pinyin));
            }

            return result;
        }

        // ===================== РЕНДЕР =====================
        function renderAll() {
            renderFilters();
            renderGrid();
            renderAnkiDeck();
        }

        function renderFilters() {
            const container = document.getElementById('filters');
            const cats = ['all', ...CATEGORY_KEYS];
            container.innerHTML = cats.map(cat => {
                const label = cat === 'all' ? 'Все' : CATEGORIES[cat].label;
                return `<button class="filter-btn ${currentCategory === cat ? 'active' : ''}" data-cat="${cat}">${label}</button>`;
            }).join('');
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    currentCategory = btn.dataset.cat;
                    renderFilters();
                    renderGrid();
                    renderAnkiDeck();
                });
            });
        }

        function renderGrid() {
            const filtered = getFilteredCards();
            const grid = document.getElementById('cardsGrid');
            const noResults = document.getElementById('noResults');
            if (filtered.length === 0) {
                grid.innerHTML = '';
                noResults.style.display = 'block';
                renderAnkiDeck();
                return;
            }
            noResults.style.display = 'none';
            grid.innerHTML = filtered.map(card => {
                return `
                <div class="card-item ${card.category}" data-id="${card.id}">
                    <div class="card-category">${CATEGORIES[card.category].label}</div>
                    <div class="card-emoji">${card.emoji}</div>
                    <div class="card-word">${card.word}</div>
                    ${pinyinVisible ? `<div class="card-pinyin">${card.pinyin}</div>` : ''}
                    ${transVisible ? `<div class="card-translation">${card.translation}</div>` : ''}
                </div>
            `;
            }).join('');
            document.querySelectorAll('.card-item').forEach(el => {
                el.addEventListener('click', () => openModal(el.dataset.id));
            });
            renderAnkiDeck();
        }

        // ===================== АНКИ =====================
        function getAnkiCards() {
            return getFilteredCards();
        }

        function renderAnkiDeck() {
            const deck = document.getElementById('ankiDeck');
            const filtered = getAnkiCards();
            if (filtered.length === 0) {
                deck.innerHTML = '<div style="font-size:0.8rem;color:var(--text-muted);">Нет карточек</div>';
                return;
            }
            if (ankiIndex >= filtered.length) ankiIndex = 0;
            const card = filtered[ankiIndex];
            ankiFlipped = false;
            const colloc1 = card.collocations && card.collocations[0] ? card.collocations[0].items : '';
            const colloc2 = card.collocations && card.collocations[1] ? card.collocations[1].items : '';
            deck.innerHTML = `
                <div class="anki-card" id="ankiCard">
                    <div class="anki-face front">
                        <div class="anki-emoji">${card.emoji}</div>
                        <div class="anki-word">${card.word}</div>
                    </div>
                    <div class="anki-face back">
                        <div class="anki-pinyin">${card.pinyin}</div>
                        <div class="anki-translation">${card.translation}</div>
                        <div class="anki-colloc">${colloc1}</div>
                        <div class="anki-colloc">${colloc2}</div>
                    </div>
                </div>
                <div class="anki-controls">
                    <button class="anki-btn" id="ankiPrev">◀</button>
                    <button class="anki-btn" id="ankiFlip">🔄</button>
                    <button class="anki-btn" id="ankiNext">▶</button>
                </div>
            `;
            document.getElementById('ankiCard')?.addEventListener('click', () => {
                ankiFlipped = !ankiFlipped;
                document.getElementById('ankiCard').classList.toggle('flipped', ankiFlipped);
            });
            document.getElementById('ankiPrev')?.addEventListener('click', () => {
                ankiIndex = (ankiIndex - 1 + filtered.length) % filtered.length;
                renderAnkiDeck();
            });
            document.getElementById('ankiNext')?.addEventListener('click', () => {
                ankiIndex = (ankiIndex + 1) % filtered.length;
                renderAnkiDeck();
            });
            document.getElementById('ankiFlip')?.addEventListener('click', () => {
                ankiFlipped = !ankiFlipped;
                document.getElementById('ankiCard').classList.toggle('flipped', ankiFlipped);
                resetAnkiTimer();
            });
            resetAnkiTimer();
        }

        function resetAnkiTimer() {
            if (ankiTimer) clearInterval(ankiTimer);
            ankiTimer = setInterval(() => {
                const filtered = getAnkiCards();
                if (filtered.length > 0) {
                    ankiIndex = (ankiIndex + 1) % filtered.length;
                    renderAnkiDeck();
                }
            }, 4000);
        }

        // ===================== МОДАЛКА =====================
        function openModal(id) {
            const card = cards.find(c => c.id === id);
            if (!card) return;
            currentModalId = id;
            isEditing = false;
            editingCard = null;
            activeTab = 'skeleton';
            updateModal(card);
            document.getElementById('cardModal').classList.add('active');
        }

        function closeModal() {
            document.getElementById('cardModal').classList.remove('active');
            currentModalId = null;
            isEditing = false;
            editingCard = null;
        }

        function updateModal(card) {
            const main = document.getElementById('modalMain');
            const side = document.getElementById('modalSide');
            if (isEditing && editingCard) {
                renderEditForm(main, side, editingCard);
                return;
            }

            const sideLinks = [
                { label: 'Каркас', target: 'sec-frame' },
                { label: 'Якорь', target: 'sec-anchor' },
                { label: 'Мнемоника', target: 'sec-mnemonics' },
                { label: 'Коллокации', target: 'sec-collocations' },
                { label: 'Полигон', target: 'sec-polyglot' },
            ];
            side.innerHTML = `
                <div class="modal-side-title">Оглавление</div>
                ${sideLinks.map(s => `<div class="modal-side-link" data-target="${s.target}">${s.label}</div>`).join('')}
            `;
            side.querySelectorAll('.modal-side-link').forEach(link => {
                link.addEventListener('click', () => {
                    const target = document.getElementById(link.dataset.target);
                    if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            });

            const tabs = [
                { key: 'skeleton', label: '📖 Скелет' },
                { key: 'cognitive', label: '🧠 Когнитив' },
                { key: 'live', label: '🗣️ Живой Китай' },
                { key: 'exam', label: '📝 Экзамен' },
            ];
            const tabsHtml = tabs.map(t => `<button class="modal-tab ${activeTab === t.key ? 'active' : ''}" data-tab="${t.key}">${t.label}</button>`).join('');

            const skeletonHtml = `
                <div class="modal-section" id="sec-frame">
                    <div class="modal-section-title">🧩 Каркас</div>
                    <div class="modal-section-body">${highlightFrame(card.frame, card.word)}</div>
                </div>
                <div class="modal-section" id="sec-anchor">
                    <div class="modal-section-title">🪝 Бытовой якорь</div>
                    <div class="modal-section-body">${highlightTarget(card.anchor, card.word)}</div>
                </div>
            `;
            const cognitiveHtml = `
                <div class="modal-section" id="sec-mnemonics">
                    <div class="modal-section-title">👁️ Мнемотехника</div>
                    <div class="modal-section-body">${card.mnemonics.map(m => highlightGlowChars(m, card.word)).join('<br>')}</div>
                </div>
