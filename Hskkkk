<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes, viewport-fit=cover">
    <title>HSK 6 · Урок 1 · 孩子给我们的启示（上）</title>
    <style>
        :root {
            --bg: #faf8f5;
            --surface: #ffffff;
            --border: #e8e2d8;
            --text: #2a2a2a;
            --text-secondary: #5a5a5a;
            --text-muted: #8a8a8a;
            --accent-cinnabar: #b5443c;
            --accent-cinnabar-soft: #fdf2f0;
            --accent-gold: #b8914a;
            --accent-gold-soft: #fdf9f0;
            --accent-bamboo: #5e7d5a;
            --accent-bookish: #4a5b8c;
            --accent-colloquial: #c07a5b;
            --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.04);
            --shadow-md: 0 8px 20px rgba(0, 0, 0, 0.08);
            --radius-lg: 16px;
            --radius-md: 12px;
            --radius-sm: 8px;
            --font-cjk: 'Noto Sans CJK SC', 'PingFang SC', 'Hiragino Sans GB', '微软雅黑', 'Heiti SC', sans-serif;
            --font-ru: 'Segoe UI', 'Roboto', system-ui, -apple-system, sans-serif;
            --transition: 0.2s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: var(--font-ru);
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            min-height: 100vh;
        }

        .container {
            max-width: 960px;
            margin: 0 auto;
            padding: 24px 16px 60px;
        }

        /* ---------- Header ---------- */
        .header {
            text-align: center;
            margin-bottom: 24px;
        }
        .header .lesson-number {
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 4px;
        }
        .header h1 {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 2px;
            letter-spacing: 0.3px;
        }
        .header .chinese-title {
            font-family: var(--font-cjk);
            font-size: 1.3rem;
            color: var(--accent-cinnabar);
            margin-bottom: 4px;
            font-weight: 600;
        }
        .header .subtitle {
            font-size: 0.8rem;
            color: var(--text-secondary);
            font-weight: 400;
        }

        /* ---------- Toolbar ---------- */
        .toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 16px;
            justify-content: space-between;
            align-items: center;
        }
        .toolbar-group {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: center;
        }
        .toggle-btn {
            border: 1px solid var(--border);
            background: var(--surface);
            padding: 8px 16px;
            border-radius: 30px;
            font-size: 0.78rem;
            font-weight: 500;
            cursor: pointer;
            transition: var(--transition);
            font-family: inherit;
            color: var(--text-secondary);
            white-space: nowrap;
            box-shadow: var(--shadow-sm);
        }
        .toggle-btn:hover {
            background: #f5f1ea;
            border-color: #d0c8b8;
            color: var(--text);
        }
        .toggle-btn.active {
            background: var(--accent-gold-soft);
            border-color: var(--accent-gold);
            color: #7a5c2e;
        }
        .toggle-btn.danger {
            color: var(--accent-cinnabar);
            border-color: #e0b4ad;
        }
        .toggle-btn.danger:hover {
            background: var(--accent-cinnabar-soft);
            border-color: var(--accent-cinnabar);
        }

        /* ---------- Search ---------- */
        .search-wrap {
            margin-bottom: 16px;
        }
        .search-wrap input {
            width: 100%;
            padding: 12px 18px;
            border-radius: 30px;
            border: 1px solid var(--border);
            background: var(--surface);
            font-size: 0.9rem;
            outline: none;
            transition: border-color var(--transition);
            font-family: inherit;
            color: var(--text);
            box-shadow: var(--shadow-sm);
        }
        .search-wrap input:focus {
            border-color: var(--accent-gold);
        }
        .search-wrap input::placeholder {
            color: var(--text-muted);
        }

        /* ---------- Handwriting + Anki Row ---------- */
        .practice-row {
            display: flex;
            gap: 16px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }
        .handwriting-pad {
            flex: 1 1 60%;
            background: var(--surface);
            border-radius: var(--radius-lg);
            padding: 12px;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border);
            min-width: 280px;
        }
        .handwriting-pad .pad-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }
        .handwriting-pad .pad-title {
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--text-secondary);
            letter-spacing: 0.5px;
        }
        .handwriting-pad .pad-actions {
            display: flex;
            gap: 6px;
        }
        .pad-btn {
            border: 1px solid var(--border);
            background: var(--surface);
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.7rem;
            cursor: pointer;
            transition: var(--transition);
            font-family: inherit;
            color: var(--text-secondary);
        }
        .pad-btn:hover {
            background: #f5f1ea;
        }
        .handwriting-pad canvas {
            width: 100%;
            aspect-ratio: 1 / 1;
            max-height: 200px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            background: #fffefc;
            display: block;
            cursor: crosshair;
        }

        .anki-deck {
            flex: 1 1 35%;
            background: var(--surface);
            border-radius: var(--radius-lg);
            padding: 16px;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border);
            min-width: 240px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }
        .anki-card {
            width: 100%;
            max-width: 260px;
            aspect-ratio: 3/4;
            perspective: 1000px;
            cursor: pointer;
            transition: transform 0.4s;
            transform-style: preserve-3d;
            position: relative;
            margin: 0 auto;
        }
        .anki-card.flipped {
            transform: rotateY(180deg);
        }
        .anki-face {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: var(--radius-md);
            backface-visibility: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border);
            padding: 12px;
        }
        .anki-face.front {
            background: var(--surface);
        }
        .anki-face.back {
            background: var(--accent-gold-soft);
            transform: rotateY(180deg);
        }
        .anki-face .anki-emoji {
            font-size: 2rem;
            margin-bottom: 4px;
        }
        .anki-face .anki-word {
            font-family: var(--font-cjk);
            font-size: 2.2rem;
            font-weight: 700;
            color: var(--text);
            line-height: 1.2;
        }
        .anki-face .anki-pinyin {
            font-size: 0.9rem;
            color: var(--text-secondary);
        }
        .anki-face .anki-translation {
            font-size: 0.85rem;
            color: var(--text-secondary);
            font-style: italic;
        }
        .anki-face .anki-colloc {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 4px;
        }
        .anki-controls {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: center;
        }
        .anki-btn {
            border: 1px solid var(--border);
            background: var(--surface);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            cursor: pointer;
            transition: var(--transition);
            font-family: inherit;
            color: var(--text-secondary);
            box-shadow: var(--shadow-sm);
        }
        .anki-btn:hover {
            background: #f5f1ea;
        }

        /* ---------- Filters ---------- */
        .filters {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 20px;
        }
        .filter-btn {
            border: 1px solid var(--border);
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            font-family: inherit;
            letter-spacing: 0.4px;
            background: var(--surface);
            color: var(--text-secondary);
            box-shadow: var(--shadow-sm);
        }
        .filter-btn:hover {
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }
        .filter-btn.active {
            background: var(--text);
            color: #fff;
            border-color: var(--text);
        }

        /* ---------- Cards Grid ---------- */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }
        .card-item {
            background: var(--surface);
            border-radius: var(--radius-lg);
            padding: 18px 16px;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border);
            position: relative;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .card-item:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
            border-color: #d0c8b8;
        }
        .card-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            bottom: 0;
            width: 4px;
            border-radius: var(--radius-lg) 0 0 var(--radius-lg);
            background: var(--accent-gold);
        }
        .card-item.bookish::before {
            background: var(--accent-bookish);
        }
        .card-item.colloquial::before {
            background: var(--accent-colloquial);
        }
        .card-item.idiom::before {
            background: var(--accent-bamboo);
        }
        .card-item .card-category {
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--text-muted);
            margin-bottom: 2px;
        }
        .card-item .card-emoji {
            font-size: 1.8rem;
            line-height: 1;
        }
        .card-item .card-word {
            font-family: var(--font-cjk);
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text);
            line-height: 1.2;
            margin-top: 4px;
        }
        .card-item .card-pinyin {
            font-size: 0.85rem;
            color: var(--text-secondary);
            font-weight: 500;
        }
        .card-item .card-translation {
            font-size: 0.8rem;
            color: var(--text-muted);
            font-style: italic;
        }

        /* ---------- No results ---------- */
        .no-results {
            text-align: center;
            padding: 30px 20px;
            background: var(--surface);
            border-radius: var(--radius-lg);
            color: var(--text-secondary);
            font-size: 0.9rem;
            box-shadow: var(--shadow-sm);
        }

        /* ---------- Add Button ---------- */
        .add-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            max-width: 400px;
            margin: 0 auto 32px;
            padding: 12px 20px;
            border-radius: 30px;
            border: 2px dashed #cfc6b4;
            background: transparent;
            color: var(--text-secondary);
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: var(--transition);
            font-family: inherit;
        }
        .add-btn:hover {
            border-color: var(--accent-gold);
            color: var(--accent-gold);
            background: var(--accent-gold-soft);
        }

        /* ---------- Exam Tips ---------- */
        .tips-section {
            background: var(--accent-cinnabar-soft);
            border-radius: var(--radius-lg);
            padding: 20px 18px;
            box-shadow: var(--shadow-sm);
            border: 1px solid #f0c8c0;
            margin-bottom: 32px;
        }
        .tips-section h2 {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 12px;
            color: var(--accent-cinnabar);
        }
        .tip-item {
            padding: 10px 0;
            border-bottom: 1px solid #f0c8c0;
        }
        .tip-item:last-child {
            border-bottom: none;
        }
        .tip-title {
            font-weight: 700;
            font-size: 0.85rem;
            color: var(--text);
            margin-bottom: 4px;
        }
        .tip-body {
            font-size: 0.8rem;
            color: var(--text-secondary);
            line-height: 1.6;
        }
        .tip-body .cn {
            font-family: var(--font-cjk);
            color: var(--accent-cinnabar);
            font-weight: 700;
        }

        /* ---------- Footer ---------- */
        footer {
            text-align: center;
            font-size: 0.7rem;
            color: var(--text-muted);
            letter-spacing: 0.3px;
        }

        /* ---------- Modal ---------- */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(30, 30, 30, 0.55);
            z-index: 1000;
            justify-content: center;
            align-items: flex-start;
            padding: 20px 16px;
            overflow-y: auto;
            backdrop-filter: blur(3px);
        }
        .modal.active {
            display: flex;
        }
        .modal-card {
            background: var(--bg);
            border-radius: var(--radius-lg);
            max-width: 800px;
            width: 100%;
            padding: 24px 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
            position: relative;
            margin: auto 0;
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
        }
        .modal-close {
            position: absolute;
            top: 14px;
            right: 16px;
            background: transparent;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--text-muted);
            transition: color var(--transition);
            line-height: 1;
            z-index: 10;
        }
        .modal-close:hover {
            color: var(--text);
        }

        /* Modal main */
        .modal-main {
            flex: 1 1 70%;
            min-width: 260px;
        }
        .modal-side {
            flex: 1 1 25%;
            min-width: 160px;
            background: var(--surface);
            border-radius: var(--radius-md);
            padding: 12px;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border);
            position: sticky;
            top: 20px;
            align-self: flex-start;
            max-height: 80vh;
            overflow-y: auto;
        }
        .modal-side-title {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--text-muted);
            margin-bottom: 8px;
        }
        .modal-side-link {
            display: block;
            font-size: 0.78rem;
            color: var(--text-secondary);
            text-decoration: none;
            padding: 4px 0;
            cursor: pointer;
            transition: color var(--transition);
            border-bottom: 1px solid var(--border);
        }
        .modal-side-link:hover {
            color: var(--accent-gold);
        }

        /* Modal header */
        .modal-header {
            text-align: center;
            margin-bottom: 20px;
        }
        .modal-emoji {
            font-size: 2.8rem;
            margin-bottom: 4px;
        }
        .modal-word {
            font-family: var(--font-cjk);
            font-size: 2.4rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 2px;
        }
        .modal-pinyin {
            font-size: 1rem;
            color: var(--text-secondary);
            margin-bottom: 2px;
        }
        .modal-translation {
            font-size: 1.05rem;
            color: var(--text-secondary);
            font-style: italic;
        }
        .modal-scene {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-top: 4px;
            letter-spacing: 2px;
        }

        /* Tabs */
        .modal-tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 16px;
        }
        .modal-tab {
            transition: all 0.15s ease;
            border-radius: 8px;
            padding: 10px 12px;
            font-weight: 600;
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--text-secondary);
            cursor: pointer;
            box-shadow: var(--shadow-sm);
            font-family: inherit;
            font-size: 0.75rem;
        }
        .modal-tab:hover {
            background: #f5f1ea;
            border-color: #d0c8b8;
        }
        .modal-tab.active {
            background: var(--text);
            color: #fff;
            border-color: var(--text);
            box-shadow: var(--shadow-md);
        }

        /* Modal content */
        .modal-content {
            font-size: 0.9rem;
            line-height: 1.7;
            color: var(--text);
        }
        .modal-section {
            margin-bottom: 20px;
        }
        .modal-section-title {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: var(--text-muted);
            margin-bottom: 6px;
            border-bottom: 1px solid var(--border);
            padding-bottom: 4px;
        }
        .modal-section-body {
            color: var(--text);
        }
        .modal-section-body .cn {
            font-family: var(--font-cjk);
            font-weight: 600;
        }
        .modal-section-body .example {
            display: block;
            margin-top: 6px;
            padding-left: 16px;
            border-left: 3px solid var(--accent-gold);
            font-style: italic;
            color: var(--text-secondary);
            font-size: 0.86rem;
        }
        .modal-section-body .dialogue-a,
        .modal-section-body .dialogue-b {
            display: block;
            margin: 4px 0;
            padding-left: 16px;
            border-left: 3px solid var(--accent-bamboo);
            font-size: 0.88rem;
        }
        .modal-section-body .dialogue-b {
            border-left-color: var(--accent-gold);
        }
        .modal-section-body .collocation-level {
            font-weight: 700;
            display: block;
            margin-top: 6px;
            color: var(--text);
        }
        .modal-section-body .polyglot-text {
            background: #f4f0e8;
            padding: 12px 14px;
            border-radius: 8px;
            font-size: 0.9rem;
            line-height: 1.8;
            margin-top: 4px;
        }
        .modal-section-body .polyglot-translation {
            margin-top: 8px;
            font-style: italic;
            color: var(--text-secondary);
            font-size: 0.85rem;
            padding-left: 16px;
            border-left: 3px solid #d0c8b8;
        }
        .glow-char {
            display: inline-block;
            animation: glowPulse 2s ease-in-out infinite;
            color: var(--accent-cinnabar);
            font-weight: 700;
        }
        @keyframes glowPulse {
            0%, 100% {
                opacity: 0.8;
                text-shadow: 0 0 4px rgba(181, 68, 60, 0.3);
            }
            50% {
                opacity: 1;
                text-shadow: 0 0 12px rgba(181, 68, 60, 0.7);
            }
        }
        .highlight-target {
            font-weight: 700;
            color: var(--accent-cinnabar);
        }
        .highlight-frame {
            background: var(--accent-gold-soft);
            padding: 0 4px;
            border-radius: 4px;
            font-weight: 600;
        }

        /* Modal actions */
        .modal-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: center;
            margin-top: 20px;
        }
        .modal-btn {
            border: none;
            padding: 8px 20px;
            border-radius: 30px;
            font-size: 0.78rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            font-family: inherit;
            letter-spacing: 0.3px;
        }
        .modal-btn.primary {
            background: var(--text);
            color: #fff;
        }
        .modal-btn.primary:hover {
            background: #1a1a1a;
        }
        .modal-btn.secondary {
            background: #eae5da;
            color: var(--text-secondary);
        }
        .modal-btn.secondary:hover {
            background: #ddd6c8;
        }
        .modal-btn.danger {
            background: var(--accent-cinnabar-soft);
            color: var(--accent-cinnabar);
        }
        .modal-btn.danger:hover {
            background: #f9d9d3;
        }

        /* Edit form */
        .edit-form label {
            display: block;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-secondary);
            margin: 12px 0 4px;
        }
        .edit-form input,
        .edit-form textarea,
        .edit-form select {
            width: 100%;
            padding: 8px 12px;
            border-radius: 8px;
            border: 1px solid var(--border);
            font-size: 0.88rem;
            font-family: inherit;
            background: var(--surface);
            outline: none;
            transition: border-color var(--transition);
            color: var(--text);
        }
        .edit-form input:focus,
        .edit-form textarea:focus,
        .edit-form select:focus {
            border-color: var(--accent-gold);
        }
        .edit-form textarea {
            min-height: 60px;
            resize: vertical;
            line-height: 1.6;
        }
        .edit-actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
            flex-wrap: wrap;
            justify-content: center;
        }

        /* Add card modal */
        .add-card-modal textarea {
            min-height: 160px;
        }

        /* Responsive */
        @media (max-width: 900px) {
            .practice-row {
                flex-direction: column;
            }
            .handwriting-pad,
            .anki-deck {
                flex: 1 1 100%;
                min-width: 100%;
            }
            .modal-card {
                flex-direction: column;
            }
            .modal-side {
                position: static;
                max-height: 200px;
                order: -1;
            }
            .cards-grid {
                grid-template-columns: 1fr;
            }
        }
        @media (max-width: 480px) {
            .header h1 {
                font-size: 1.5rem;
            }
