                    <input type="text" id="efTrans" value="${card.translation}">
                    <label>Категория</label>
                    <select id="efCat">${CATEGORY_KEYS.map(k => `<option value="${k}" ${card.category === k ? 'selected' : ''}>${CATEGORIES[k].label}</option>`).join('')}</select>
                    <label>Ритм тонов</label>
                    <input type="text" id="efRhythm" value="${card.rhythm}">
