                    <textarea id="efMnemonics">${card.mnemonics.join('\n')}</textarea>
                    <label>Как работают вместе</label>
                    <textarea id="efWork">${card.workTogether}</textarea>
                    <label>Цельная картинка</label>
                    <textarea id="efFullImage">${card.fullImage}</textarea>
                    <label>Сцена (чипсы)</label>
                    <input type="text" id="efSceneChips" value="${card.sceneChips || ''}">
                    <label>Морфемы</label>
                    <input type="text" id="efMorph" value="${card.morphemes}">
                    <label>Однокоренной куст (каждая с новой строки)</label>
                    <textarea id="efCognates">${card.cognates.join('\n')}</textarea>
                    <label>Контрастная пара (если есть)</label>
                    <textarea id="efContrast">${card.contrastPair}</textarea>
                    <label>Фишка автора</label>
                    <textarea id="efExpertise">${card.expertise}</textarea>
                    <label>Вайб в соцсетях</label>
                    <textarea id="efSocial">${card.socialVibe}</textarea>
                    <label>Инсайт эксперта</label>
                    <textarea id="efInsight">${card.expertInsight}</textarea>
                    <label>Речевая редукция (если есть)</label>
                    <textarea id="efReduction">${card.reduction}</textarea>
                    <label>Диалог: реплика А</label>
                    <textarea id="efDialA">${card.dialogue[0] || ''}</textarea>
                    <label>Диалог: реплика Б</label>
                    <textarea id="efDialB">${card.dialogue[1] || ''}</textarea>
                    <label>Коллокация: 🎯 HSK 3.0 (уровень|описание|пример)</label>
                    <textarea id="efColloc1">${card.collocations[0] ? card.collocations[0].level + '|' + card.collocations[0].items + '|' + card.collocations[0].example : ''}</textarea>
                    <label>Коллокация: 🗣️ Быт (уровень|описание|пример)</label>
                    <textarea id="efColloc2">${card.collocations[1] ? card.collocations[1].level + '|' + card.collocations[1].items + '|' + card.collocations[1].example : ''}</textarea>
                    <label>Коллокация: 🎥 Медиа (уровень|описание|пример)</label>
                    <textarea id="efColloc3">${card.collocations[2] ? card.collocations[2].level + '|' + card.collocations[2].items + '|' + card.collocations[2].example : ''}</textarea>
                    <label>Полигон: текст</label>
                    <textarea id="efPolyText">${card.polyglotText}</textarea>
                    <label>Полигон: перевод</label>
                    <textarea id="efPolyTrans">${card.polyglotTranslation}</textarea>
                    <div class="edit-actions">
                        <button class="modal-btn primary" id="saveEditBtn">💾 Сохранить</button>
                        <button class="modal-btn danger" id="cancelEditBtn">↩️ Отмена</button>
                    </div>
                </div>
            `;
            document.getElementById('saveEditBtn')?.addEventListener('click', saveFromForm);
            document.getElementById('cancelEditBtn')?.addEventListener('click', cancelEdit);
        }

        function saveFromForm() {
            const get = (id) => document.getElementById(id)?.value.trim() || '';
            const collocations = [];
            const parseColloc = (val) => {
                const parts = val.split('|').map(s => s.trim());
                if (parts.length === 3) return { level: parts[0], items: parts[1], example: parts[2] };
                return null;
            };
            const c1 = parseColloc(get('efColloc1'));
            const c2 = parseColloc(get('efColloc2'));
            const c3 = parseColloc(get('efColloc3'));
            if (c1) collocations.push(c1);
            if (c2) collocations.push(c2);
            if (c3) collocations.push(c3);

            const updated = {
                ...editingCard,
                emoji: get('efEmoji'),
                word: get('efWord'),
                pinyin: get('efPinyin'),
                translation: get('efTrans'),
                category: get('efCat'),
                rhythm: get('efRhythm'),
                type: get('efType'),
                frame: get('efFrame'),
                anchor: get('efAnchor'),
                mnemonics: get('efMnemonics').split('\n').filter(s => s.trim()),
                workTogether: get('efWork'),
                fullImage: get('efFullImage'),
                sceneChips: get('efSceneChips'),
                morphemes: get('efMorph'),
                cognates: get('efCognates').split('\n').filter(s => s.trim()),
                contrastPair: get('efContrast'),
                expertise: get('efExpertise'),
                socialVibe: get('efSocial'),
                expertInsight: get('efInsight'),
                reduction: get('efReduction'),
                dialogue: [get('efDialA'), get('efDialB')].filter(s => s),
                collocations: collocations,
                polyglotText: get('efPolyText'),
                polyglotTranslation: get('efPolyTrans')
            };

            const index = cards.findIndex(c => c.id === editingCard.id);
            if (index !== -1) {
                cards[index] = updated;
                saveCards();
                isEditing = false;
                editingCard = null;
                updateModal(updated);
                renderGrid();
            }
        }

        function cancelEdit() {
            isEditing = false;
            editingCard = null;
            if (currentModalId) {
                const card = cards.find(c => c.id === currentModalId);
                if (card) updateModal(card);
            }
        }

        function closeAllModals() {
            document.getElementById('cardModal').classList.remove('active');
            document.getElementById('addModal').classList.remove('active');
        }

        // ===================== ПОДСВЕТКА =====================
        function highlightGlowChars(text, word) {
            if (!text || !word) return text;
            const chars = word.split('');
            let result = text;
            chars.forEach(ch => {
                if (ch && ch !== ' ') {
                    result = result.replace(new RegExp(ch, 'g'), `<span class="glow-char">${ch}</span>`);
                }
            });
            return result;
        }

        function highlightTarget(text, word) {
            if (!text || !word) return text;
            return text.replace(new RegExp(word, 'g'), `<span class="highlight-target">${word}</span>`);
        }

        function highlightFrame(text, word) {
            if (!text) return text;
            let result = text;
            result = highlightTarget(result, word);
            result = result.replace(/\[([^\]]+)\]/g, `<span class="highlight-frame">[$1]</span>`);
            return result;
        }

        // ===================== ДОБАВЛЕНИЕ =====================
        function openAddModal() {
            const container = document.getElementById('addContent');
            container.innerHTML = `
                <h2 style="margin-bottom:16px;">➕ Новая карточка</h2>
                <div style="margin-bottom:12px;">
                    <label style="font-weight:600;font-size:0.85rem;">📋 Вставьте текст в нашем формате — парсер сам разберет</label>
                    <textarea id="parseArea" style="width:100%;min-height:160px;padding:12px;border-radius:8px;border:1px solid #ddd;font-family:inherit;font-size:0.9rem;line-height:1.6;" placeholder="📌 [ 词语 ] cíyǔ — значение&#10;🎵 Ритм тонов: 1-2&#10;📐 Тип: ...&#10;🧩 Каркас: ...&#10;🪝 Бытовой якорь: ..."></textarea>
                </div>
                <div style="margin-bottom:12px;">
                    <label style="font-weight:600;font-size:0.85rem;">🏷️ Категория</label>
                    <select id="newCat" style="width:100%;padding:10px;border-radius:8px;border:1px solid #ddd;font-family:inherit;font-size:0.9rem;">${CATEGORY_KEYS.map(k => `<option value="${k}">${CATEGORIES[k].label}</option>`).join('')}</select>
                </div>
                <div class="modal-actions">
                    <button class="modal-btn primary" id="magicBtn">✨ Магически создать</button>
                    <button class="modal-btn secondary" id="manualBtn">📝 Вручную</button>
                </div>
            `;
            document.getElementById('magicBtn').addEventListener('click', magicCreate);
            document.getElementById('manualBtn').addEventListener('click', manualCreate);
            document.getElementById('addModal').classList.add('active');
        }

        function closeAddModal() {
            document.getElementById('addModal').classList.remove('active');
        }

        function magicCreate() {
            const text = document.getElementById('parseArea').value.trim();
            const category = document.getElementById('newCat').value;
            if (!text) { alert('Вставьте текст.'); return; }
            const card = parseToCard(text, category);
            if (!card.word) { alert('Не удалось распознать слово.'); return; }
            card.id = 'card_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5);
            if (!card.emoji) card.emoji = '📘';
            cards.push(card);
            saveCards();
            renderAll();
            closeAddModal();
            openModal(card.id);
        }

        function manualCreate() {
            const category = document.getElementById('newCat').value;
            const blank = {
                id: 'card_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5),
                word: '', emoji: '📘', pinyin: '', translation: '', category: category,
                rhythm: '', type: '', frame: '', anchor: '', mnemonics: [],
                workTogether: '', fullImage: '', sceneChips: '', morphemes: '', cognates: [],
                contrastPair: '', expertise: '', socialVibe: '', expertInsight: '',
                reduction: '', dialogue: ['', ''], collocations: [
                    { level: '🎯 HSK 3.0', items: '', example: '' },
                    { level: '🗣️ Быт', items: '', example: '' },
                    { level: '🎥 Медиа/СМИ', items: '', example: '' }
                ],
                polyglotText: '', polyglotTranslation: ''
            };
            cards.push(blank);
            saveCards();
            renderAll();
            closeAddModal();
            openModal(blank.id);
            isEditing = true;
            editingCard = JSON.parse(JSON.stringify(blank));
            updateModal(blank);
        }

        function parseToCard(text, category) {
            const card = {
                word: '', emoji: '📘', pinyin: '', translation: '', category: category,
                rhythm: '', type: '', frame: '', anchor: '', mnemonics: [],
                workTogether: '', fullImage: '', sceneChips: '', morphemes: '', cognates: [],
                contrastPair: '', expertise: '', socialVibe: '', expertInsight: '',
                reduction: '', dialogue: ['', ''], collocations: [
                    { level: '🎯 HSK 3.0', items: '', example: '' },
                    { level: '🗣️ Быт', items: '', example: '' },
                    { level: '🎥 Медиа/СМИ', items: '', example: '' }
                ],
                polyglotText: '', polyglotTranslation: ''
            };

            const lines = text.split('\n').map(l => l.trim()).filter(l => l);

            const mainLine = lines.find(l => l.includes('[') && l.includes(']'));
            if (mainLine) {
                const match = mainLine.match(/\[([^\]]+)\]\s*([\w\sāáǎàēéěèīíǐìōóǒòūúǔùǖǘǚǜüÜĀÁǍÀĒÉĚÈĪÍǏÌŌÓǑÒŪÚǓÙǕǗǙǛ]+)\s*[—–\-–]\s*(.+)/);
                if (match) {
                    card.word = match[1].trim();
                    card.pinyin = match[2].trim();
                    card.translation = match[3].trim();
                } else {
                    const simple = mainLine.match(/\[([^\]]+)\]\s*(.+)/);
                    if (simple) {
                        card.word = simple[1].trim();
                        const rest = simple[2].trim();
                        const pm = rest.match(/^([\w\sāáǎàēéěèīíǐìōóǒòūúǔùǖǘǚǜüÜĀÁǍÀĒÉĚÈĪÍǏÌŌÓǑÒŪÚǓÙǕǗǙǛ]+)/);
                        if (pm) {
                            card.pinyin = pm[1].trim();
                            card.translation = rest.replace(pm[1], '').replace(/^[—–\-–]\s*/, '').trim();
                        }
                    }
                }
            }

            for (let i = 0; i < lines.length; i++) {
                const line = lines[i];
                if (!line) continue;
                if (line.includes('Ритм тонов')) card.rhythm = line.replace(/.*Ритм тонов[:\s]*/, '').trim();
                else if (line.includes('Тип:')) card.type = line.replace(/.*Тип[:\s]*/, '').trim();
                else if (line.includes('Каркас')) card.frame = line.replace(/.*Каркас[:\s]*/, '').trim();
                else if (line.includes('Бытовой якорь')) card.anchor = line.replace(/.*Бытовой якорь[:\s]*/, '').trim();
                else if (line.includes('Мнемотехника') || line.includes('👁️')) {
                    const mnemonics = [];
                    let j = i + 1;
                    while (j < lines.length) {
                        const next = lines[j];
                        if (next.includes('Как работают вместе') || next.includes('Цельная картинка') || next.includes('🧩 Как') || next.includes('🖼️')) break;
                        if (next.startsWith('*') || next.startsWith('·') || next.startsWith('•') || next.startsWith('-')) {
                            mnemonics.push(next.replace(/^[*\s·•\-–]+/, '').trim());
                        }
                        j++;
                    }
                    if (mnemonics.length) card.mnemonics = mnemonics;
                    i = j - 1;
                } else if (line.includes('Как работают вместе')) card.workTogether = line.replace(/.*Как работают вместе[:\s]*/, '').trim();
                else if (line.includes('Цельная картинка')) card.fullImage = line.replace(/.*Цельная картинка[:\s]*/, '').trim();
                else if (line.includes('Сцена')) card.sceneChips = line.replace(/.*Сцена[^:]*[:\s]*/, '').trim();
                else if (line.includes('Морфемы')) card.morphemes = line.replace(/.*Морфемы[:\s]*/, '').trim();
                else if (line.includes('Однокоренной куст')) {
                    const cognates = [];
                    let j = i + 1;
                    while (j < lines.length) {
                        const next = lines[j];
                        if (next.includes('🔁') || next.includes('Контрастная пара') || next.includes('Экспертиза') || next.includes('💡')) break;
                        if (next.includes('➔') || next.startsWith('*') || next.startsWith('·') || next.startsWith('•') || next.startsWith('-')) {
                            cognates.push(next.replace(/^[*\s·•\-–]+/, '').trim());
                        }
                        j++;
                    }
                    if (cognates.length) card.cognates = cognates;
                    i = j - 1;
                } else if (line.includes('Контрастная пара') || line.includes('🔁')) {
                    card.contrastPair = line.replace(/.*Контрастная пара[:\s]*/, '').trim();
                    if (!card.contrastPair && i + 1 < lines.length) { card.contrastPair = lines[i + 1].trim();
                        i++; }
                } else if (line.includes('Фишка автора')) card.expertise = line.replace(/.*Фишка автора[:\s]*/, '').trim();
                else if (line.includes('Вайб в')) card.socialVibe = line.replace(/.*Вайб в[^:]*[:\s]*/, '').trim();
                else if (line.includes('Инсайт эксперта')) card.expertInsight = line.replace(/.*Инсайт эксперта[:\s]*/, '').trim();
                else if (line.includes('Речевая редукция')) card.reduction = line.replace(/.*Речевая редукция[:\s]*/, '').trim();
                else if (line.includes('🅰') || line.startsWith('A:')) card.dialogue[0] = line.replace(/^🅰\s*/, '').trim();
                else if (line.includes('🅱') || line.startsWith('B:')) card.dialogue[1] = line.replace(/^🅱\s*/, '').trim();
                else if (line.includes('🎯 HSK 3.0') || line.includes('HSK 3.0')) {
                    const rest = line.replace(/.*🎯 HSK 3.0[:\s]*/, '').trim();
                    const parts = rest.split('|');
                    if (parts.length >= 1) card.collocations[0].items = parts[0].trim();
                    if (parts.length >= 2) card.collocations[0].example = parts[1].trim();
                    else if (i + 1 < lines.length) { card.collocations[0].example = lines[i + 1].trim();
                        i++; }
                } else if (line.includes('🗣️ Быт')) {
                    const rest = line.replace(/.*🗣️ Быт[:\s]*/, '').trim();
                    const parts = rest.split('|');
                    if (parts.length >= 1) card.collocations[1].items = parts[0].trim();
                    if (parts.length >= 2) card.collocations[1].example = parts[1].trim();
                    else if (i + 1 < lines.length) { card.collocations[1].example = lines[i + 1].trim();
                        i++; }
                } else if (line.includes('🎥 Медиа') || line.includes('Медиа/СМИ')) {
                    const rest = line.replace(/.*🎥 Медиа\/СМИ[:\s]*/, '').trim();
                    const parts = rest.split('|');
                    if (parts.length >= 1) card.collocations[2].items = parts[0].trim();
                    if (parts.length >= 2) card.collocations[2].example = parts[1].trim();
                    else if (i + 1 < lines.length) { card.collocations[2].example = lines[i + 1].trim();
                        i++; }
                } else if (line.includes('Текст:')) card.polyglotText = line.replace(/.*Текст[:\s]*/, '').trim();
                else if (line.includes('Перевод:')) card.polyglotTranslation = line.replace(/.*Перевод[:\s]*/, '').trim();
            }

            return card;
        }

        // ===================== CANVAS =====================
        const canvas = document.getElementById('handwritingCanvas');
        const ctx = canvas.getContext('2d');
        let drawing = false;
        let strokeHistory = [];
        let redoHistory = [];

        function resizeCanvas() {
            const rect = canvas.parentElement.getBoundingClientRect();
            const size = Math.min(rect.width - 24, 200);
            canvas.width = size;
            canvas.height = size;
            ctx.lineWidth = 3;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            ctx.strokeStyle = '#2a2a2a';
        }
        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);

        function getPos(e) {
            const rect = canvas.getBoundingClientRect();
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            return {
                x: clientX - rect.left,
                y: clientY - rect.top
            };
        }

        canvas.addEventListener('mousedown', (e) => {
            drawing = true;
            const pos = getPos(e);
            ctx.beginPath();
            ctx.moveTo(pos.x, pos.y);
            strokeHistory.push([]);
            strokeHistory[strokeHistory.length - 1].push({ x: pos.x, y: pos.y });
            redoHistory = [];
        });
        canvas.addEventListener('mousemove', (e) => {
            if (!drawing) return;
            const pos = getPos(e);
            ctx.lineTo(pos.x, pos.y);
            ctx.stroke();
            strokeHistory[strokeHistory.length - 1].push({ x: pos.x, y: pos.y });
        });
        canvas.addEventListener('mouseup', () => { drawing = false; });
        canvas.addEventListener('mouseleave', () => { drawing = false; });

        canvas.addEventListener('touchstart', (e) => {
            e.preventDefault();
            drawing = true;
            const pos = getPos(e);
            ctx.beginPath();
            ctx.moveTo(pos.x, pos.y);
            strokeHistory.push([]);
            strokeHistory[strokeHistory.length - 1].push({ x: pos.x, y: pos.y });
            redoHistory = [];
        });
        canvas.addEventListener('touchmove', (e) => {
            e.preventDefault();
            if (!drawing) return;
            const pos = getPos(e);
            ctx.lineTo(pos.x, pos.y);
            ctx.stroke();
            strokeHistory[strokeHistory.length - 1].push({ x: pos.x, y: pos.y });
        });
        canvas.addEventListener('touchend', () => { drawing = false; });

        document.getElementById('undoStroke').addEventListener('click', () => {
            if (strokeHistory.length === 0) return;
            redoHistory.push(strokeHistory.pop());
            redrawCanvas();
        });
        document.getElementById('redoStroke').addEventListener('click', () => {
            if (redoHistory.length === 0) return;
            strokeHistory.push(redoHistory.pop());
            redrawCanvas();
        });
        document.getElementById('clearCanvas').addEventListener('click', () => {
            strokeHistory = [];
            redoHistory = [];
            redrawCanvas();
        });

        function redrawCanvas() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            strokeHistory.forEach(stroke => {
                if (stroke.length < 2) return;
                ctx.beginPath();
                ctx.moveTo(stroke[0].x, stroke[0].y);
                for (let i = 1; i < stroke.length; i++) {
                    ctx.lineTo(stroke[i].x, stroke[i].y);
                }
                ctx.stroke();
            });
        }

        // ===================== СОБЫТИЯ =====================
        document.getElementById('pinyinToggle').addEventListener('click', () => {
            pinyinVisible = !pinyinVisible;
            const btn = document.getElementById('pinyinToggle');
            btn.textContent = pinyinVisible ? '🔊 Пиньинь: Вкл' : '🔇 Пиньинь: Выкл';
            btn.classList.toggle('active', pinyinVisible);
            renderGrid();
            if (currentModalId) { const c = cards.find(x => x.id === currentModalId); if (c && !isEditing) updateModal(c); }
        });
        document.getElementById('transToggle').addEventListener('click', () => {
            transVisible = !transVisible;
            const btn = document.getElementById('transToggle');
            btn.textContent = transVisible ? '☀️ Перевод: Вкл' : '🌙 Перевод: Выкл';
            btn.classList.toggle('active', transVisible);
            renderGrid();
            if (currentModalId) { const c = cards.find(x => x.id === currentModalId); if (c && !isEditing) updateModal(c); }
        });

        document.getElementById('searchInput').addEventListener('input', e => {
            searchQuery = e.target.value;
            renderAll();
        });
        document.getElementById('searchInput').addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                document.getElementById('searchInput').value = '';
                searchQuery = '';
                renderAll();
            }
        });

        document.getElementById('partFilter').addEventListener('change', (e) => {
            partFilter = e.target.value;
            renderAll();
        });
        document.getElementById('sortFilter').addEventListener('change', (e) => {
            sortOrder = e.target.value;
            renderAll();
        });

        document.getElementById('closeModalBtn').addEventListener('click', closeModal);
        document.getElementById('cardModal').addEventListener('click', e => { if (e.target === document.getElementById('cardModal')) closeModal(); });
        document.getElementById('closeAddBtn').addEventListener('click', closeAddModal);
        document.getElementById('addModal').addEventListener('click', e => { if (e.target === document.getElementById('addModal')) closeAddModal(); });
        document.getElementById('addBtn').addEventListener('click', openAddModal);

        // Кнопка сброса — в футере (по требованию)
        document.querySelector('footer').addEventListener('dblclick', () => {
            if (confirm('Двойное подтверждение: сбросить все карточки к исходным?')) {
                cards = [...defaultCards];
                saveCards();
                renderAll();
                closeAllModals();
            }
        });

        // ===================== ИНИЦИАЛИЗАЦИЯ =====================
        loadCards();
        renderAll();
        resetAnkiTimer();
    </script>
