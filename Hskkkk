                    <div class="modal-section-body">${card.fullImage}</div>
                </div>
                <div class="modal-section">
                    <div class="modal-section-title">🌳 Морфемы</div>
                    <div class="modal-section-body">${highlightGlowChars(card.morphemes, card.word)}</div>
                </div>
                <div class="modal-section">
                    <div class="modal-section-title">🌳 Однокоренной куст</div>
                    <div class="modal-section-body">${card.cognates.map(c => c).join('<br>')}</div>
                </div>
                ${card.contrastPair ? `
                <div class="modal-section">
                    <div class="modal-section-title">🔁 Контрастная пара</div>
                    <div class="modal-section-body">${card.contrastPair}</div>
                </div>` : ''}
            `;
            const liveHtml = `
                ${card.reduction ? `
                <div class="modal-section">
                    <div class="modal-section-title">🗣️ Речевая редукция</div>
                    <div class="modal-section-body">${card.reduction}</div>
                </div>` : ''}
                <div class="modal-section">
                    <div class="modal-section-title">💬 Живой диалог</div>
                    <div class="modal-section-body">
                        <div class="dialogue-a">🅰 ${highlightTarget(card.dialogue[0], card.word)}</div>
                        <div class="dialogue-b">🅱 ${highlightTarget(card.dialogue[1], card.word)}</div>
                    </div>
                </div>
                <div class="modal-section" id="sec-collocations">
                    <div class="modal-section-title">🔗 Коллокации</div>
                    <div class="modal-section-body">
                        ${card.collocations.map(c => `
                            <span class="collocation-level">${c.level}</span> ${c.items}
                            <span class="example">${c.example}</span>
                        `).join('')}
                    </div>
                </div>
                <div class="modal-section">
                    <div class="modal-section-title">💡 Соц. вайб</div>
                    <div class="modal-section-body">${card.socialVibe}</div>
                </div>
            `;
            const examHtml = `
                <div class="modal-section">
                    <div class="modal-section-title">🧠 Инсайт эксперта</div>
                    <div class="modal-section-body">${card.expertInsight}</div>
                </div>
                <div class="modal-section">
                    <div class="modal-section-title">💡 Фишка автора</div>
                    <div class="modal-section-body">${card.expertise}</div>
                </div>
                <div class="modal-section" id="sec-polyglot">
                    <div class="modal-section-title">🎯 Полигон</div>
                    <div class="modal-section-body">
                        <div class="polyglot-text">${highlightTarget(card.polyglotText, card.word)}</div>
                        <div class="polyglot-translation">${card.polyglotTranslation}</div>
                    </div>
                </div>
            `;

            const sections = {
                skeleton: skeletonHtml,
                cognitive: cognitiveHtml,
                live: liveHtml,
                exam: examHtml,
            };

            main.innerHTML = `
                <div class="modal-header">
                    <div class="modal-emoji">${card.emoji}</div>
                    <div class="modal-word">${card.word}</div>
                    <div class="modal-pinyin">${pinyinVisible ? card.pinyin : '🔒 пиньинь скрыт'}</div>
                    <div class="modal-translation">${transVisible ? card.translation : '🔒 перевод скрыт'}</div>
                    ${card.sceneChips ? `<div class="modal-scene">${card.sceneChips}</div>` : ''}
                    <div class="modal-section-body" style="margin-top:8px;font-size:0.8rem;color:var(--text-muted);">Ритм: ${card.rhythm}</div>
                    <div class="modal-section-body" style="font-size:0.8rem;color:var(--text-muted);">Тип: ${card.type}</div>
                </div>
                <div class="modal-tabs">${tabsHtml}</div>
                <div class="modal-content">${sections[activeTab]}</div>
                <div class="modal-actions">
                    <button class="modal-btn secondary" id="editBtn">✏️ Редактировать</button>
                    <button class="modal-btn secondary" id="closeBtn">✕ Закрыть</button>
                </div>
            `;

            document.querySelectorAll('.modal-tab').forEach(tab => {
                tab.addEventListener('click', () => {
                    activeTab = tab.dataset.tab;
                    updateModal(card);
                });
            });
            document.getElementById('editBtn')?.addEventListener('click', () => {
                isEditing = true;
                editingCard = JSON.parse(JSON.stringify(card));
                updateModal(card);
            });
            document.getElementById('closeBtn')?.addEventListener('click', closeModal);
        }

        function renderEditForm(main, side, card) {
            side.innerHTML = '';
            main.innerHTML = `
                <h2 style="margin-bottom:16px;">✏️ Редактирование</h2>
                <div class="edit-form">
